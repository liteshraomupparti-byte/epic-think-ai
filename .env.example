# Hindsight Long-Term Memory Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# Server Configuration
PORT=3001

# Firebase Configuration
FIREBASE_PROJECT_ID=epic-think
# Optional path to Firebase service account JSON file for server-side token verification:
FIREBASE_SERVICE_ACCOUNT_PATH=

# MongoDB Database Configuration (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/epic_think_ai
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/epic_think_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/epic_think_ai
MONGODB_DB_NAME=epic_think_ai

# Plugin System Security Configuration (32-byte hex key for AES-256-GCM token vault)
PLUGIN_ENCRYPTION_KEY=

# Multi-Provider AI Engine Configuration
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Primary High-Quality Image Model (Gemini 3 Pro Image / Nano Banana Pro)
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# Fast Tier Image Model (Gemini 3.1 Flash Image)
GEMINI_FAST_IMAGE_MODEL=gemini-3.1-flash-image

# Search Engine Intelligence
SERPAPI_API_KEY=

# Image Generation Studio Configuration (enter.pollinations.ai)
# Optional: unlocks frontier Flux.2 models without rate limits and provides watermark-free output
POLLINATIONS_API_KEY=

AI_DEFAULT_PROVIDER=groq
AI_DEFAULT_MODEL=openai/gpt-oss-120b
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_MODEL=gemini-3.5-flash

AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_TOOL_ITERATIONS=5
AI_ENABLE_STREAMING=true
AI_ENABLE_PARALLEL_TOOLS=true
AI_ENABLE_MULTI_PROVIDER=true

# Notion OAuth Integration Configuration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://epic-think-ai.vercel.app/api/plugins/notion/oauth/callback
